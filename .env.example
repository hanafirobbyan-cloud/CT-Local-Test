# =============================================================================
# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env ke Git.
# =============================================================================

# --- Aplikasi ---------------------------------------------------------------
# development | production
APP_ENV=development
# Wajib di produksi. Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# URL publik situs (dipakai untuk tautan di WhatsApp/email & QR sertifikat), tanpa "/" di akhir
PUBLIC_BASE_URL=http://localhost:5000
APP_TIMEZONE=Asia/Jakarta
# Isi 1 bila aplikasi berada di belakang reverse proxy (Nginx, Caddy, Render, Railway, dsb.)
TRUST_PROXY=0
# Default: true bila APP_ENV=production (cookie hanya lewat HTTPS)
# SESSION_COOKIE_SECURE=true
ADMIN_SESSION_HOURS=8
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15

# --- Database ---------------------------------------------------------------
# Kosong = SQLite di instance/webinar.db (cukup untuk ratusan–ribuan peserta).
# PostgreSQL: postgresql://user:password@host:5432/webinar
DATABASE_URL=

# Khusus docker-compose: password database PostgreSQL bawaan compose
POSTGRES_PASSWORD=

# --- Rate limiting ----------------------------------------------------------
# memory:// cukup untuk 1 proses. Untuk beberapa worker gunicorn gunakan Redis: redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# --- WhatsApp -----------------------------------------------------------------
# meta     = WhatsApp Business Platform (Cloud API) resmi — DIREKOMENDASIKAN
# fonnte   = gateway pihak ketiga (bukan API resmi Meta; baca risikonya di docs/WHATSAPP.md)
# console  = hanya menulis ke log (development; otomatis nonaktif di produksi)
# disabled = tidak mengirim (pesan tetap antre sampai provider diaktifkan)
WHATSAPP_PROVIDER=disabled

# Meta Cloud API (developers.facebook.com > App > WhatsApp > API Setup)
WA_META_API_VERSION=v23.0
WA_META_PHONE_NUMBER_ID=
# Gunakan System User access token permanen (bukan token sementara 24 jam)
WA_META_ACCESS_TOKEN=
# App Secret (App settings > Basic) — wajib untuk verifikasi tanda tangan webhook
WA_META_APP_SECRET=
# String acak buatan Anda, diisi juga di konfigurasi webhook Meta
WA_META_VERIFY_TOKEN=
# Nama template yang sudah DISETUJUI Meta (lihat docs/WHATSAPP.md untuk isi template)
WA_TEMPLATE_LANGUAGE=id
WA_TEMPLATE_REGISTRATION=webinar_registrasi
WA_TEMPLATE_ZOOM_LINK=webinar_link_zoom
WA_TEMPLATE_REMINDER=webinar_pengingat
WA_TEMPLATE_CERTIFICATE=webinar_sertifikat
WA_TEMPLATE_ANNOUNCEMENT=webinar_pengumuman

# Fonnte (fonnte.com > Device > Token)
FONNTE_TOKEN=
# String acak; URL webhook Fonnte: https://domain-anda/webhooks/whatsapp/fonnte/status?token=<nilai ini>
FONNTE_WEBHOOK_SECRET=

# Jeda antar pesan WhatsApp (ms) & batas percobaan ulang
WA_SEND_DELAY_MS=200
MESSAGE_MAX_ATTEMPTS=4

# --- Email SMTP (opsional; cadangan untuk peserta tanpa izin WA & pengiriman sertifikat) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls | ssl | none
SMTP_SECURITY=starttls
MAIL_FROM="Panitia Webinar <webinar@domain-anda.id>"

# --- Zoom API (opsional; menarik laporan kehadiran otomatis) --------------------
# marketplace.zoom.us > Develop > Build App > Server-to-Server OAuth
# Scope: report:read:list_meeting_participants:admin (akun Zoom Pro ke atas)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# true bila memakai domain Zoom kustom (mis. vanity URL kampus)
ZOOM_ALLOW_ANY_DOMAIN=false

# --- API untuk bot / integrasi ---------------------------------------------------
# Format: nama:token,nama2:token2 (token min. 24 karakter)
API_TOKENS=
# Webhook keluar (event registration.created, attendance.marked, certificate.issued, dll.)
INTEGRATION_WEBHOOK_URL=
INTEGRATION_WEBHOOK_SECRET=

# --- Worker & backup ---------------------------------------------------------
WORKER_INTERVAL_SECONDS=5
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14
MAX_UPLOAD_MB=5
